{
  "opencollection": "1.0.0",
  "info": {
    "name": "Thought Industries REST Content Groups API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.thoughtindustries.com/incoming/api/v1/groups",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of all user groups."
        },
        {
          "info": {
            "name": "Add User to Group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.thoughtindustries.com/incoming/api/v1/groups/:groupId/users",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "Group ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Assigns a user to an existing group."
        }
      ]
    }
  ],
  "bundled": true
}